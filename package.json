{
  "name": "liveseal",
  "version": "0.1.0",
  "description": "A cryptographic seal hidden in live video, so the other side of a call can check who is really sending it.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"core/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite",
    "build": "vite build && node scripts/build-extension.ts",
    "build:extension": "node scripts/build-extension.ts",
    "preview": "vite preview",
    "sim:channel": "node codec-sim/run-channel.ts",
    "sim:digest": "node codec-sim/digest-extract.ts && node codec-sim/digest-eval.ts",
    "measure:browser": "node scripts/browser-loopback.ts",
    "vendor": "node scripts/vendor.ts",
    "sim:attacks": "node codec-sim/run-attacks.ts",
    "sim:tables": "node codec-sim/make-tables.ts",
    "check:terms": "node scripts/check-terms.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "@noble/ed25519": "^3.0.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.0"
  }
}
